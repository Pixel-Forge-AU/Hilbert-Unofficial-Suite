DATABASE_URL=postgresql://planner:planner@localhost:39010/planner
REDIS_URL=redis://localhost:39011

DEFAULT_LLM_PROVIDER=openai-compatible
# Suite's always-on qwen-sidecar (config.env: QWEN_SIDECAR_HOST/PORT) - stays up even
# when ComfyUI/the main llama.cpp instance are stopped, so the planner keeps working
# regardless of what else is running.
DEFAULT_LLM_BASE_URL=http://127.0.0.1:39002/v1
DEFAULT_LLM_MODEL=qwen-sidecar
DEFAULT_LLM_API_KEY=

# Per-stage model routing (opt-in): swaps the single loaded model on a remote server
# between stage groups since stages run strictly sequentially. See model-switcher.ts.
# Leave blank unless you run a per-stage model-management endpoint of your own - every
# stage then uses DEFAULT_LLM_MODEL.
LLM_MANAGEMENT_BASE_URL=

PLANNER_DEFAULT_QUALITY_SCORE=92
PLANNER_DEFAULT_MAX_REVISIONS=4
PLANNER_DEFAULT_STRICTNESS=9
PLANNER_DEFAULT_CREATIVITY=9
PLANNER_DEFAULT_DETAIL_LEVEL=10

PLANNER_STAGE_TIMEOUT_MS=2400000
PLANNER_MODEL_RETRY_COUNT=3
PLANNER_SCHEMA_REPAIR_COUNT=5
PLANNER_MODEL_MAX_OUTPUT_TOKENS=24000
PLANNER_WORKER_CONCURRENCY=1

LOG_LEVEL=info
STORE_RAW_LLM_OUTPUT=true
STORE_RAW_PROMPTS=false
PORT=39006

# implementation-orchestrator's API (not this planner's own port)
IMPLEMENTATION_ORCHESTRATOR_URL=http://localhost:39007
