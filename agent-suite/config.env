# Agent Suite configuration (read by agent_manager.py / agent-switch).
#
# Paths default to this folder (ROOT/models, ROOT/repos/llama.cpp, ROOT/planner-pipeline,
# ...). Relative *_DIR values below are resolved against this folder, not the cwd.
#
# --- Ports ---
# Shares the 39000-39018 block with the creative suite (../ai-suite); these are the ones
# this suite owns. OLLAMA_PORT is NOT actually movable via this file - Ollama's real bind
# address/port comes from its systemd unit (start_ollama() just runs
# `systemctl start ollama`), and 11434 is a convention many Ollama clients hardcode.
#
# 39001 llama          39007 orchestrator      39012/39013 orchestrator postgres/redis (docker)
# 39002 qwen-sidecar   39008 genesis           39016 pipeline dashboard
# 39006 planner        39009 openhands         39017 openhands vscode (Docker path only)
# 39019 console        39010/39011 planner postgres/redis (docker)

# The creative suite, whose `ai-switch comfy-stop` is called before the main LLM takes
# the GPU. Leave as-is when both suites sit side by side in hilbert-unofficial-suite/.
CREATIVE_SUITE_DIR=../ai-suite

# LLM weights and the llama.cpp build still live in the creative suite's folder (hundreds
# of GB, not moved during the split). Point these at wherever they actually are.
MODELS_DIR=../ai-suite/models
LLAMA_CPP_DIR=../ai-suite/repos/llama.cpp

# --- LLM serving ---
LLAMA_HOST=0.0.0.0
LLAMA_PORT=39001
LLAMA_CTX=131072
LLAMA_GPU_LAYERS=999
LLAMA_ALIAS=qwen-agentworld-35b-a3b-ud-iq4_xs
LLAMA_MODEL=
LLAMA_EXTRA_ARGS=--flash-attn on --device Vulkan0 --batch-size 2048 --ubatch-size 512 --parallel 1

# Sidecar LLM that is not stopped when ComfyUI starts. The build pipeline and OpenHands
# use this one (see planner-pipeline/.env and implementation-orchestrator/.env).
QWEN_SIDECAR_HOST=0.0.0.0
QWEN_SIDECAR_PORT=39002
QWEN_SIDECAR_CTX=32768
QWEN_SIDECAR_GPU_LAYERS=0
QWEN_SIDECAR_REASONING=off
QWEN_SIDECAR_HF_REPO=
QWEN_SIDECAR_ALIAS=qwythos-9b-claude-mythos-5-1m-q4_k_m

# Optional local file path. If absent, llama.cpp will download/use the HF repo.
LLAMA_HERETIC_HF_REPO=llmfan46/Qwen3.6-35B-A3B-uncensored-heretic-GGUF:Q4_K_M
LLAMA_HERETIC_ALIAS=qwen3.6-35b-a3b-heretic
LLAMA_HERETIC_CTX=131072

# Second, smaller Heretic profile (27B vs the 35B above) - separate slot/alias so both
# stay independently selectable. No local file yet: llama.cpp downloads/caches the HF
# repo into MODELS_DIR/qwen3.5-27b-heretic on first start.
LLAMA_HERETIC27_HF_REPO=mradermacher/Qwen3.5-27B-heretic-GGUF:Q4_K_M
LLAMA_HERETIC27_ALIAS=qwen3.5-27b-heretic
LLAMA_HERETIC27_CTX=131072

# Vision projector for the 27B Heretic slot (f16, ~928MB). Same local-file-first,
# then-download-by-URL pattern as the main model above.
LLAMA_HERETIC27_MMPROJ_URL=https://huggingface.co/mradermacher/Qwen3.5-27B-heretic-GGUF/resolve/main/Qwen3.5-27B-heretic.mmproj-f16.gguf

# NOTE: not actually movable via this file - see the port-block comment above.
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:0.6b

# --- AI build pipeline ---
# planner-pipeline turns a project brief into a build manifest; implementation-orchestrator
# executes that manifest as a task graph via builder agents, dispatching to the real
# OpenHands agent-server below. Each of planner-pipeline/implementation-orchestrator owns
# its own Postgres/Redis via docker compose (see each service's own docker-compose.yml/.env).
PLANNER_HOST=127.0.0.1
PLANNER_PORT=39006

ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=39007

# Plugin-host runtime (unrelated to the planner/orchestrator pipeline above). Ships
# with zero plugins by default - see genesis-runtime/README.md to point
# GENESIS_PLUGIN_DIR at a real plugin catalog.
GENESIS_HOST=0.0.0.0
GENESIS_PORT=39008

# Real OpenHands agent-server (standalone REST API from the openhands-agent-server
# PyPI package, not the whole Agent Canvas app) - the actual builder backend
# implementation-orchestrator's "openhands-local" profile talks to. install.sh clones
# and builds ./open-hands and generates OPENHANDS_SESSION_API_KEY below.
OPENHANDS_HOST=0.0.0.0
OPENHANDS_PORT=39009
OPENHANDS_SESSION_API_KEY=

# Only used by the Docker path in pipeline-dashboard-server.mjs's OpenHands controls (an
# alternative to `agent-switch openhands`'s native agent-server above - use one or the
# other, not both). Exposes the agent-server's bundled web IDE.
OPENHANDS_VSCODE_PORT=39017

# Control-plane web UI for planner/orchestrator/OpenHands: start/stop, config editing, plan
# submission, live OpenHands chat/IDE. Start via `agent-switch pipeline-dashboard`.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=39016

# This machine's ROCm/HSA runtime reports the wrong gfx target for some AMD
# APUs (e.g. Ryzen AI Max / Radeon 8060S, gfx1151). Set the override your GPU needs.
HSA_OVERRIDE_GFX_VERSION=

# Runtime + Performance web console (system stats, service controls, LLM tuning and
# model slots). Studio proxies its /api/performance/* calls here for the Chat tab.
# Start via `agent-switch console`.
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=39019
