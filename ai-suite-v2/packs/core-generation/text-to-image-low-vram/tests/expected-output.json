{
  "workflow_id": "core.text-to-image-low-vram",
  "inputs": {
    "prompt": "A peaceful forest path with sunlight filtering through trees",
    "negative_prompt": "low quality, blurry, text, watermark",
    "width": 768,
    "height": 768,
    "seed": 54321,
    "cfg": 7.0
  },
  "expected_output": {
    "type": "image",
    "format": "webp",
    "dimensions": [768, 768],
    "properties": {
      "has_content": true,
      "no_watermark": true,
      "no_artifacts": true
    }
  },
  "validation": {
    "min_resolution": [512, 512],
    "max_file_size_mb": 15,
    "required_features": [
      "forest path",
      "sunlight",
      "trees"
    ],
    "low_vram_requirements": {
      "max_vram_usage_gb": 6,
      "cpu_offload": true
    }
  }
}