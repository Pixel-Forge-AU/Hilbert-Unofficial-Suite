# Fast Preset for Text-to-Image Fast

name: Fast
description: Quick generation for drafts and thumbnails

generation:
  width: 1024
  height: 1024
  steps: 12
  cfg: 2.0
  batch_size: 1

sampling:
  sampler: euler
  scheduler: simple
  denoise: 1.0

quality:
  enable_upscale: false
  enable_face_restore: false
  enable_sharpen: false

runtime:
  low_vram: true
  cpu_offload: true
  enable_tiling: false
  enable_cpu_offload: true