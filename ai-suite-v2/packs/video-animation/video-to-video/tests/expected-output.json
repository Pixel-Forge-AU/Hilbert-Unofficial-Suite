{
  "workflow_id": "video.video-to-video",
  "inputs": {
    "enhancement_factor": 2.0,
    "denoise_strength": 0.5,
    "stabilization": true,
    "fps_boost": false,
    "seed": 42
  },
  "expected_output": {
    "type": "video",
    "format": "webp",
    "duration_multiplier": 1.0,
    "resolution_multiplier": 2.0,
    "fps": 24,
    "properties": {
      "no_artifacts": true,
      "no_noise": true,
      "stable_motion": true,
      "enhanced_detail": true
    }
  },
  "validation": {
    "min_duration": 1.0,
    "max_duration": 120.0,
    "min_resolution": [512, 512],
    "max_file_size_mb": 100,
    "required_features": [
      "enhanced",
      "stabilized",
      "clean"
    ]
  }
}