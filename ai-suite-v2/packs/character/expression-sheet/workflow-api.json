{
  "name": "Expression Sheet API",
  "description": "Facial expression sheet generation with multiple expressions",
  "version": "1.0.0",
  "workflow_id": "character.expression-sheet",
  "endpoints": {
    "generate": {
      "path": "/api/v1/generate/character-expression-sheet",
      "method": "POST",
      "description": "Generate an expression sheet with multiple faces"
    },
    "preview": {
      "path": "/api/v1/preview/character-expression-sheet",
      "method": "GET",
      "description": "Preview the expression sheet generation"
    }
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "description": "Positive prompt describing the character face"
      },
      "negative_prompt": {
        "type": "string",
        "default": "",
        "description": "Negative prompt for undesirable elements"
      },
      "width": {
        "type": "integer",
        "default": 1024,
        "minimum": 512,
        "maximum": 4096
      },
      "height": {
        "type": "integer",
        "default": 768,
        "minimum": 512,
        "maximum": 4096
      },
      "seed": {
        "type": "integer",
        "default": -1
      },
      "cfg": {
        "type": "number",
        "default": 7.0
      },
      "steps": {
        "type": "integer",
        "default": 30
      },
      "checkpoint": {
        "type": "string",
        "default": "flux"
      },
      "expressions": {
        "type": "string",
        "default": "happy,sad,angry,surprised,neutral",
        "description": "Comma-separated list of expressions to generate"
      }
    },
    "required": ["prompt"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "image": {
        "type": "string",
        "format": "uri"
      },
      "seed": {
        "type": "integer"
      },
      "metadata": {
        "type": "object"
      }
    }
  },
  "models": {
    "required": [
      "flux",
      "sdxl",
      "sd15",
      "sd3"
    ],
    "optional": [
      "lora",
      "controlnet"
    ]
  }
}