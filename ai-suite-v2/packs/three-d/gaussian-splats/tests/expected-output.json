{
  "workflow_id": "three-d.gaussian-splats",
  "inputs": {
    "image": "base64_image",
    "prompt": "cute robot character",
    "views": 4,
    "density": 1.0,
    "optimization_steps": 500
  },
  "expected_output": {
    "type": "gaussian_splats",
    "formats": ["ply"],
    "properties": {
      "has_valid_gaussians": true,
      "real_time_renderable": true,
      "novel_view_synthesis": true,
      "high_fidelity": true,
      "gaussian_count_range": [10000, 500000]
    },
    "preview": {
      "type": "image",
      "format": "webp",
      "dimensions": [1024, 1024]
    },
    "rendering": {
      "type": "360_rotation",
      "fps": 30,
      "duration_seconds": 5
    }
  },
  "validation": {
    "required_features": [
      "valid-gaussians",
      "real-time-renderable",
      "novel-view-synthesis"
    ],
    "optional_features": [
      "sh-coefficients",
      "opacity-optimization"
    ]
  }
}