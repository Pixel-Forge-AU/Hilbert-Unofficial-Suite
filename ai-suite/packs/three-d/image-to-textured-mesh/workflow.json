{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    }
  },
  "2": {
    "class_type": "Hy3DModelLoader",
    "inputs": {
      "model": "hunyuan3d-dit-v2-0-fp16.safetensors",
      "attention_mode": "sdpa",
      "cublas_ops": false
    }
  },
  "3": {
    "class_type": "Hy3DGenerateMesh",
    "inputs": {
      "pipeline": ["2", 0],
      "image": ["1", 0],
      "guidance_scale": 5.5,
      "steps": 50,
      "seed": 123
    }
  },
  "4": {
    "class_type": "Hy3DVAEDecode",
    "inputs": {
      "vae": ["2", 1],
      "latents": ["3", 0],
      "box_v": 1.01,
      "octree_resolution": 384,
      "num_chunks": 8000,
      "mc_level": 0.0,
      "mc_algo": "mc"
    }
  },
  "5": {
    "class_type": "Hy3DPostprocessMesh",
    "inputs": {
      "trimesh": ["4", 0],
      "remove_floaters": true,
      "remove_degenerate_faces": true,
      "reduce_faces": true,
      "max_facenum": 40000,
      "smooth_normals": false
    }
  },
  "6": {
    "class_type": "Hy3DMeshUVWrap",
    "inputs": {
      "trimesh": ["5", 0]
    }
  },
  "7": {
    "class_type": "Hy3DCameraConfig",
    "inputs": {
      "camera_azimuths": "0, 90, 180, 270, 0, 180",
      "camera_elevations": "0, 0, 0, 0, 90, -90",
      "view_weights": "1, 0.1, 0.5, 0.1, 0.05, 0.05",
      "camera_distance": 1.45,
      "ortho_scale": 1.2
    }
  },
  "8": {
    "class_type": "Hy3DRenderMultiView",
    "inputs": {
      "trimesh": ["6", 0],
      "render_size": 1024,
      "texture_size": 2048,
      "camera_config": ["7", 0],
      "normal_space": "world"
    }
  },
  "9": {
    "class_type": "DownloadAndLoadHy3DDelightModel",
    "inputs": {
      "model": "hunyuan3d-delight-v2-0"
    }
  },
  "10": {
    "class_type": "Hy3DDelightImage",
    "inputs": {
      "delight_pipe": ["9", 0],
      "image": ["1", 0],
      "steps": 50,
      "width": 512,
      "height": 512,
      "cfg_image": 1.0,
      "seed": 42
    }
  },
  "11": {
    "class_type": "DownloadAndLoadHy3DPaintModel",
    "inputs": {
      "model": "hunyuan3d-paint-v2-0"
    }
  },
  "12": {
    "class_type": "Hy3DSampleMultiView",
    "inputs": {
      "pipeline": ["11", 0],
      "ref_image": ["10", 0],
      "normal_maps": ["8", 0],
      "position_maps": ["8", 1],
      "view_size": 512,
      "steps": 25,
      "seed": 1024,
      "camera_config": ["7", 0]
    }
  },
  "13": {
    "class_type": "Hy3DBakeFromMultiview",
    "inputs": {
      "images": ["12", 0],
      "renderer": ["8", 2],
      "camera_config": ["7", 0]
    }
  },
  "14": {
    "class_type": "Hy3DMeshVerticeInpaintTexture",
    "inputs": {
      "texture": ["13", 0],
      "mask": ["13", 1],
      "renderer": ["13", 2]
    }
  },
  "15": {
    "class_type": "CV2InpaintTexture",
    "inputs": {
      "texture": ["14", 0],
      "mask": ["14", 1],
      "inpaint_radius": 3,
      "inpaint_method": "ns"
    }
  },
  "16": {
    "class_type": "Hy3DApplyTexture",
    "inputs": {
      "texture": ["15", 0],
      "renderer": ["14", 2]
    }
  },
  "17": {
    "class_type": "Hy3DExportMesh",
    "inputs": {
      "trimesh": ["16", 0],
      "filename_prefix": "3d/image-to-textured-mesh",
      "file_format": "glb",
      "save_file": true
    }
  }
}
