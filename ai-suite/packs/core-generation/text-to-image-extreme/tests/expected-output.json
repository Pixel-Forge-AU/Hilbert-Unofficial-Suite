{
  "workflow_id": "core.text-to-image-extreme",
  "inputs": {
    "prompt": "A breathtaking view of the northern lights over a mountain lake with pine trees",
    "negative_prompt": "low quality, blurry, text, watermark",
    "width": 1024,
    "height": 1024,
    "seed": 54321,
    "cfg": 8.0
  },
  "expected_output": {
    "type": "image",
    "format": "webp",
    "dimensions": [1024, 1024],
    "properties": {
      "has_content": true,
      "no_watermark": true,
      "no_artifacts": true
    }
  },
  "validation": {
    "min_resolution": [512, 512],
    "max_file_size_mb": 20,
    "required_features": [
      "northern lights",
      "mountain",
      "lake",
      "pine trees"
    ]
  }
}