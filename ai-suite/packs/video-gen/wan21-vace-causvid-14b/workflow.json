      "title": "Frame Interpolation",
      "properties": {
        "widget_ue_connectable": {}
      },
      "widgets_values": [
        "Frame interpolation is necessary here since 16 frames per seconds visibly stutters. The eye starts to see a smooth movement with 24 frames per seconds. And so we do a frame interpolation here, and add inbetween frames. We end in 32 frames this way. Which is smooth.\n"
      ],
      "color": "#432",
      "bgcolor": "#653"
    },
