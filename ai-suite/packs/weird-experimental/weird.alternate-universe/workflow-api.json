{
  "version": "1.0.0",
  "name": "Alternate Universe API",
  "description": "API-compatible version of alternate universe effects workflow",
  "parameters": {
    "prompt": {
      "type": "string",
      "required": true,
      "description": "Prompt describing the alternate reality concept"
    },
    "universe_type": {
      "type": "string",
      "required": false,
      "default": "cyberpunk",
      "enum": [
        "cyberpunk",
        "fantasy",
        "steampunk",
        "biopunk",
        "dystopian",
        "utopian",
        "alien"
      ],
      "description": "Type of alternate universe"
    },
    "reality_shift": {
      "type": "float",
      "required": false,
      "default": 0.7,
      "minimum": 0.0,
      "maximum": 1.0,
      "step": 0.01,
      "description": "How much to shift reality"
    },
    "color_palette": {
      "type": "string",
      "required": false,
      "default": "neon-cyberpunk",
      "enum": [
        "neon-cyberpunk",
        "pastel-fantasy",
        "sepia-vintage",
        "monochrome-silent",
        "ultraviolet-alien"
      ],
      "description": "Color palette for the universe"
    }
  }
}