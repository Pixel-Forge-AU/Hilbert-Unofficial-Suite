{
  "workflow_id": "character.character-sheet",
  "inputs": {
    "prompt": "character design sheet with 3-view: front, side, back views of a young warrior with silver armor",
    "negative_prompt": "low quality, blurry, text, watermark",
    "width": 1536,
    "height": 768,
    "seed": 42,
    "cfg": 7.0,
    "steps": 30
  },
  "expected_output": {
    "type": "image",
    "format": "webp",
    "dimensions": [1536, 768],
    "properties": {
      "has_content": true,
      "no_watermark": true,
      "no_artifacts": true,
      "show_multiple_angles": true,
      "show_front": true,
      "show_side": true,
      "show_back": true,
      "consistent_character": true
    }
  },
  "validation": {
    "min_resolution": [1024, 512],
    "max_file_size_mb": 20,
    "required_features": [
      "character-sheet",
      "multi-angle",
      "reference-sheet"
    ]
  }
}