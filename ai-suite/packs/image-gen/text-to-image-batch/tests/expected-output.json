{
  "workflow_id": "core.text-to-image-batch",
  "inputs": {
    "prompt": "A peaceful forest path with sunlight filtering through trees",
    "negative_prompt": "low quality, blurry, text, watermark",
    "width": 1024,
    "height": 1024,
    "batch_size": 4,
    "seed": 42,
    "cfg": 8.0
  },
  "expected_output": {
    "type": "array[image]",
    "format": "webp",
    "dimensions": [1024, 1024],
    "properties": {
      "batch_count": 4,
      "has_content": true,
      "no_watermark": true,
      "no_artifacts": true
    }
  },
  "validation": {
    "min_resolution": [512, 512],
    "max_file_size_mb": 60,
    "required_features": [
      "forest path",
      "sunlight",
      "trees"
    ],
    "batch_requirements": {
      "min_images": 4,
      "max_images": 4,
      "consistent_style": true
    }
  }
}