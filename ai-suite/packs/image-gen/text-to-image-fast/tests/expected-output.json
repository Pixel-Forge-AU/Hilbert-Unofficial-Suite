{
  "workflow_id": "core.text-to-image-fast",
  "inputs": {
    "prompt": "A futuristic city in the clouds with flying vehicles and neon lights",
    "negative_prompt": "low quality, blurry, text, watermark",
    "width": 1024,
    "height": 1024,
    "seed": 42,
    "cfg": 2.0
  },
  "expected_output": {
    "type": "image",
    "format": "webp",
    "dimensions": [1024, 1024],
    "properties": {
      "has_content": true,
      "no_watermark": true,
      "no_artifacts": true
    }
  },
  "validation": {
    "min_resolution": [512, 512],
    "max_file_size_mb": 10,
    "required_features": [
      "city",
      "clouds",
      "vehicles"
    ]
  }
}