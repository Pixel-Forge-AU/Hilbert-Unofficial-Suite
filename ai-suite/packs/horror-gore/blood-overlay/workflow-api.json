{
  "name": "Blood Overlay Effects API",
  "description": "Generate blood overlay effects effects for horror and gore applications",
  "version": "1.0.0",
  "workflow_id": "horror.blood-overlay",
  "endpoints": {
    "generate": {
      "path": "/api/v1/generate/horror-blood-overlay",
      "method": "POST",
      "description": "Apply Blood Overlay Effects effects"
    },
    "preview": {
      "path": "/api/v1/preview/horror-blood-overlay",
      "method": "GET",
      "description": "Preview the Blood Overlay Effects effect"
    }
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "image": {
        "type": "string",
        "format": "uri",
        "description": "Base image to apply effects to"
      },
      "prompt": {
        "type": "string",
        "default": "",
        "description": "Positive prompt for additional details"
      },
      "negative_prompt": {
        "type": "string",
        "default": "",
        "description": "Negative prompt for undesirable elements"
      },
      "seed": {
        "type": "integer",
        "default": -1
      },
      "cfg": {
        "type": "number",
        "default": 7.0
      },
      "steps": {
        "type": "integer",
        "default": 25
      }
    },
    "required": [
      "image"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "image": {
        "type": "string",
        "format": "uri"
      },
      "mask": {
        "type": "string",
        "format": "uri"
      },
      "metadata": {
        "type": "object"
      }
    }
  },
  "models": {
    "required": [
      "flux",
      "sdxl",
      "sd15",
      "qwen",
      "wan",
      "hunyuan"
    ],
    "optional": [
      "lora",
      "controlnet"
    ]
  }
}