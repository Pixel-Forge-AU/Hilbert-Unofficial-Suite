{
  "name": "implementation-orchestrator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --include '**/*.integration.test.ts'",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "typecheck": "pnpm -r run typecheck",
    "dev:api": "pnpm --filter @implementation-orchestrator/api run dev",
    "dev:worker": "pnpm --filter @implementation-orchestrator/worker run dev",
    "db:generate": "pnpm --filter @implementation-orchestrator/database run generate",
    "db:migrate": "pnpm --filter @implementation-orchestrator/database run migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "3.2.6",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "fast-uri": ">=4.1.3",
      "find-my-way": ">=9.7.0",
      "undici": ">=6.27.0",
      "uuid": ">=11.1.1",
      "vite": "^7.3.6"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
