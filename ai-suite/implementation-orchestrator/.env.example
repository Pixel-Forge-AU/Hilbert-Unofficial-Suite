DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:39012/orchestrator
REDIS_URL=redis://localhost:39013

# __INSTALL_DIR__ is substituted by install.sh with this suite's actual install path.
WORKSPACE_ROOT=__INSTALL_DIR__/orchestrator-workspaces
ARTIFACT_STORAGE_PROVIDER=filesystem
ARTIFACT_STORAGE_PATH=__INSTALL_DIR__/orchestrator-artifacts

DEFAULT_POLICY_PROFILE=default-safe
DEFAULT_BUILDER_PROFILE=openhands-local

MAX_CONCURRENT_TASKS=1
MAX_CONCURRENT_BUILDERS=1

DEFAULT_TASK_TIMEOUT_SECONDS=1800
DEFAULT_LEASE_DURATION_SECONDS=2100
DEFAULT_HEARTBEAT_INTERVAL_SECONDS=30

DEFAULT_MAX_BUILDER_ATTEMPTS=3
DEFAULT_MAX_REMEDIATION_CYCLES=3
DEFAULT_GLOBAL_RETRY_BUDGET=12
LEASE_SWEEP_INTERVAL_MS=30000
RETRY_SWEEP_INTERVAL_MS=15000
TASK_POLL_INTERVAL_MS=2000

# Real OpenHands agent-server (openhands-agent-server PyPI package, run standalone via
# `ai-switch openhands` from ../open-hands - install.sh clones and builds it). It runs as
# a bare host process sharing this filesystem directly (not a container), so
# OPENHANDS_CONTAINER_WORKSPACE_ROOT is left blank - no path translation needed (see
# OpenHandsAdapterConfig's doc comment in
# packages/builder-gateway/src/openhands/openhands-adapter.ts). OPENHANDS_SESSION_API_KEY
# is generated fresh by install.sh and must match config.env's copy of the same value.
OPENHANDS_BASE_URL=http://127.0.0.1:39009
OPENHANDS_SESSION_API_KEY=
OPENHANDS_LLM_MODEL=openai/qwen-sidecar
OPENHANDS_LLM_API_KEY=not-needed-local
OPENHANDS_LLM_BASE_URL=http://127.0.0.1:39002/v1
OPENHANDS_LLM_USAGE_ID=implementation-orchestrator
OPENHANDS_CONTAINER_WORKSPACE_ROOT=

REQUIRE_CLEAN_BASE_BRANCH=true
REQUIRE_WORKFLOW_BRANCH=true
REQUIRE_TASK_COMMITS=true

ALLOW_DESTRUCTIVE_MIGRATIONS=false
ALLOW_DEPENDENCY_MAJOR_UPGRADES=false
ALLOW_PRODUCTION_DEPLOYMENT=false
ALLOW_FORCE_PUSH=false
ALLOW_SECRET_MODIFICATION=false

LOG_LEVEL=info
STORE_BUILDER_TRANSCRIPTS=true
STORE_COMMAND_OUTPUT=true

PORT=39007
HOST=0.0.0.0
