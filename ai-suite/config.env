# AI Suite configuration.
#
# Paths are intentionally omitted here: ai_manager.py resolves REPOS_DIR, MODELS_DIR,
# COMFYUI_DIR, LLAMA_CPP_DIR, PLANNER_DIR, ORCHESTRATOR_DIR, GENESIS_DIR, OPENHANDS_DIR,
# and the model file paths relative to wherever this folder lives (ROOT/repos,
# ROOT/models, ROOT/planner-pipeline, ...), so this file works unmodified no matter where
# you install it. Only add a *_DIR or *_MODEL line below if you want to override that
# default, e.g. to point at models stored on a separate drive.

# --- Ports ---
# All suite-managed services live in the uncommonly-used 39000-39015 block (not an
# IANA-registered range, not a default for any other software on this box) so nothing
# here collides with other local dev tools. Exception: OLLAMA_PORT is NOT actually
# movable via this file - Ollama's real bind address/port comes from its systemd unit
# (ai_manager.py's start_ollama() just runs `systemctl start ollama`, no --port flag),
# and 11434 is a convention many external Ollama clients hardcode. Changing it means
# editing /etc/systemd/system/ollama.service(.d/) on your own system, not this file.
#
# 39000 studio        39006 planner            39012 orchestrator postgres (docker)
# 39001 llama         39007 orchestrator        39013 orchestrator redis (docker)
# 39002 qwen-sidecar  39008 genesis             39014/39015 orchestrator minio api/console (docker, unused)
# 39003 comfyui       39009 openhands agent-server   39016 pipeline dashboard (pipeline-dashboard-server.mjs)
# 39004 chat          39010 planner postgres (docker) 39017 openhands vscode (bundled web IDE, Docker path only)
# 39005 playwright    39011 planner redis (docker)

LLAMA_HOST=0.0.0.0
LLAMA_PORT=39001
LLAMA_CTX=131072
LLAMA_GPU_LAYERS=999
LLAMA_ALIAS=qwen3-coder-next

# Optional OpenAI-compatible LLM endpoints to try for studio LLM workflows before
# local fallbacks. Use comma-separated entries, optionally with a model override:
# LLM_ENDPOINTS=http://192.168.0.50:8080/v1|qwen2.5-14b,http://192.168.0.51:11434/v1|qwen3
LLM_ENDPOINTS=

# Sidecar LLM that is not stopped when ComfyUI starts.
QWEN_SIDECAR_HOST=0.0.0.0
QWEN_SIDECAR_PORT=39002
QWEN_SIDECAR_CTX=32768
QWEN_SIDECAR_GPU_LAYERS=0
QWEN_SIDECAR_REASONING=off
QWEN_SIDECAR_HF_REPO=
QWEN_SIDECAR_ALIAS=qwythos-9b-claude-mythos-5-1m-q4_k_m

# Optional local file path. If absent, llama.cpp will download/use the HF repo.
LLAMA_HERETIC_HF_REPO=llmfan46/Qwen3.6-35B-A3B-uncensored-heretic-GGUF:Q4_K_M
LLAMA_HERETIC_ALIAS=qwen3.6-35b-a3b-heretic
LLAMA_HERETIC_CTX=131072

# Second, smaller Heretic profile (27B vs the 35B above) - separate slot/alias so both
# stay independently selectable. No local file yet: llama.cpp downloads/caches the HF
# repo into MODELS_DIR/qwen3.5-27b-heretic on first start.
LLAMA_HERETIC27_HF_REPO=mradermacher/Qwen3.5-27B-heretic-GGUF:Q4_K_M
LLAMA_HERETIC27_ALIAS=qwen3.5-27b-heretic
LLAMA_HERETIC27_CTX=131072

# Vision projector for the 27B Heretic slot (f16, ~928MB). Same local-file-first,
# then-download-by-URL pattern as the main model above.
LLAMA_HERETIC27_MMPROJ_URL=https://huggingface.co/mradermacher/Qwen3.5-27B-heretic-GGUF/resolve/main/Qwen3.5-27B-heretic.mmproj-f16.gguf

# NOTE: not actually movable via this file - see the port-block comment above.
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:0.6b

COMFY_HOST=0.0.0.0
COMFY_PORT=39003
COMFY_MODE=gpu
COMFY_PREFLIGHT=1
# Memory cgroup ceiling on the ComfyUI process (124G box). MemorySwapMax=0
# means hitting the ceiling gets it OOM-killed instantly instead of
# swap-thrashing for hours the way it did on 2026-07-27. Leave
# COMFY_MEMORY_MAX blank to run uncapped.
COMFY_MEMORY_MAX=100G
COMFY_MEMORY_HIGH=90G
COMFY_MEMORY_SWAP_MAX=0

CHAT_HOST=0.0.0.0
CHAT_PORT=39004

STUDIO_HOST=0.0.0.0
STUDIO_PORT=39000

PLAYWRIGHT_HOST=127.0.0.1
PLAYWRIGHT_PORT=39005

# AI software-build pipeline: planner-pipeline turns a project brief into a build
# manifest; implementation-orchestrator executes that manifest as a task graph via
# builder agents, dispatching to the real OpenHands agent-server below. Each of
# planner-pipeline/implementation-orchestrator owns its own Postgres/Redis via docker
# compose (see each service's own docker-compose.yml/.env for those ports).
PLANNER_HOST=127.0.0.1
PLANNER_PORT=39006

ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=39007

# Plugin-host runtime (unrelated to the planner/orchestrator pipeline above). Ships
# with zero plugins by default - see genesis-runtime/README.md to point
# GENESIS_PLUGIN_DIR at a real plugin catalog.
GENESIS_HOST=0.0.0.0
GENESIS_PORT=39008

# Real OpenHands agent-server (standalone REST API from the openhands-agent-server
# PyPI package, not the whole Agent Canvas app) - the actual builder backend
# implementation-orchestrator's "openhands-local" profile talks to. install.sh clones
# and builds ../open-hands and generates OPENHANDS_SESSION_API_KEY below.
OPENHANDS_HOST=0.0.0.0
OPENHANDS_PORT=39009
OPENHANDS_SESSION_API_KEY=

# Only used by the Docker path in pipeline-dashboard-server.mjs's OpenHands controls (an
# alternative to `ai-switch openhands`'s native agent-server above - use one or the other, not
# both). Exposes the agent-server's bundled web IDE.
OPENHANDS_VSCODE_PORT=39017

# Control-plane web UI for planner/orchestrator/OpenHands: start/stop, config editing, plan
# submission, live OpenHands chat/IDE. Start via `ai-switch pipeline-dashboard`.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=39016

# This machine's ROCm/HSA runtime reports the wrong gfx target for some AMD
# APUs (e.g. Ryzen AI Max / Radeon 8060S, gfx1151). If diag/health shows a
# gfx mismatch, set the override your GPU needs, e.g. HSA_OVERRIDE_GFX_VERSION=11.0.0
HSA_OVERRIDE_GFX_VERSION=
