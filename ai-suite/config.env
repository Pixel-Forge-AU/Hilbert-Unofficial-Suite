# AI Suite (creative) configuration.
#
# Paths are intentionally omitted here: ai_manager.py resolves REPOS_DIR, COMFYUI_DIR and
# friends relative to wherever this folder lives (ROOT/repos, ...), so this file works
# unmodified no matter where you install it. Only add a *_DIR line below if you want to
# override that default.
#
# LLM serving (llama.cpp, qwen-sidecar, Ollama) belongs to the agent suite next door:
# its LLAMA_*, QWEN_SIDECAR_*, OLLAMA_* and MODELS_DIR settings live in
# ../agent-suite/config.env and are read from there. Set AGENT_SUITE_DIR here if the
# agent suite is installed somewhere else.

# --- Ports ---
# Both suites share the uncommonly-used 39000-39018 block (not an IANA-registered range,
# not a default for any other software on this box). The ones this suite owns:
#
# 39000 studio        39004 chat               39018 remote GPU worker dispatcher
# 39003 comfyui       39005 playwright
#
# The agent suite owns 39001/39002 (llama, qwen-sidecar), 39006-39013 and 39016/39017 -
# see ../agent-suite/config.env.

# Optional OpenAI-compatible LLM endpoints to try for studio LLM workflows before
# local fallbacks. Use comma-separated entries, optionally with a model override:
# LLM_ENDPOINTS=http://127.0.0.1:8080/v1|qwen2.5-14b,http://127.0.0.1:11434/v1|qwen3
#
# Optional OpenAI-compatible inference endpoints. Configure private endpoints locally.
LLM_ENDPOINTS=

COMFY_HOST=0.0.0.0
COMFY_PORT=39003
COMFY_MODE=gpu
COMFY_PREFLIGHT=1
# Memory cgroup ceiling on the ComfyUI process (124G box). MemorySwapMax=0
# means hitting the ceiling gets it OOM-killed instantly instead of
# swap-thrashing for hours the way it did on 2026-07-27. Leave
# COMFY_MEMORY_MAX blank to run uncapped.
COMFY_MEMORY_MAX=100G
COMFY_MEMORY_HIGH=90G
COMFY_MEMORY_SWAP_MAX=0

CHAT_HOST=0.0.0.0
CHAT_PORT=39004

STUDIO_HOST=0.0.0.0
STUDIO_PORT=39000

PLAYWRIGHT_HOST=0.0.0.0
PLAYWRIGHT_PORT=39005

# Optional remote GPU worker dispatcher. Configure it for your own infrastructure.
GPU_WORKER_HOST=0.0.0.0
GPU_WORKER_PORT=39018
GPU_WORKER_CONFIG=./gpu-worker/config.yaml

# Automatic remote routing applies to workflows whose declared minimum VRAM
# is at most the configured REMOTE_GPU_MAX_VRAM_GB value.
REMOTE_GPU_WORKER_ENABLED=0
REMOTE_GPU_WORKER_URL=
REMOTE_GPU_MAX_VRAM_GB=16
REMOTE_GPU_FALLBACK_LOCAL=1
# Optional mounted-filesystem fast path. Leave blank to use the dispatcher's
# HTTP asset transfer API (the default and portable option).
REMOTE_GPU_INPUT_DIR=
REMOTE_GPU_OUTPUT_DIR=

# This machine's ROCm/HSA runtime reports the wrong gfx target for some AMD
# APUs (e.g. Ryzen AI Max / Radeon 8060S, gfx1151). If diag/health shows a
# gfx mismatch, set the override your GPU needs, e.g. HSA_OVERRIDE_GFX_VERSION=

HSA_OVERRIDE_GFX_VERSION=

# Optional shared secret for a trusted reverse proxy. Configure locally and keep private.
HEARTH_STUDIO_AUTH_SECRET=